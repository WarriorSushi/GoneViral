{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "goneviral-scheduled-operations-staging",
  "main": "index.mjs",
  "compatibility_date": "2026-09-02",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "GONEVIRAL_SCHEDULED_OPERATIONS_BASE_URL": "https://goneviral-phase15-preview-warriorsushis-projects.vercel.app",
    "GONEVIRAL_SCHEDULED_OPERATIONS_ENABLED": "false",
  },
  "triggers": {
    "crons": ["*/5 * * * *", "17 * * * *", "43 2 * * *"],
  },
}
