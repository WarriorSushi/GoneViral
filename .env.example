# Public, browser-safe configuration. Never put secrets behind NEXT_PUBLIC_.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Runtime database connections (configure in Phase 2).
DATABASE_URL=
DATABASE_DIRECT_URL=

# Server-only Supabase key. Prefer the current sb_secret_ key type.
SUPABASE_SECRET_KEY=

# Payment provider credentials (configure for sandbox in Phase 4 only).
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=

# Server-only integrations (configured in later phases).
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
CLICK_HMAC_SECRET_CURRENT=
CLICK_HMAC_SECRET_PREVIOUS=
SENTRY_AUTH_TOKEN=
CRON_SECRET=

# Live payment capability remains off until every launch gate is satisfied.
PAYMENTS_ENABLED=false
