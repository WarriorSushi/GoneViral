# Public, browser-safe configuration. Never put secrets behind NEXT_PUBLIC_.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Auth owns passwordless sessions. Configure matching hosted Site URL
# and exact /auth/callback redirect URLs; never expose SUPABASE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Runtime uses a Supavisor transaction pooler; prepared statements are disabled.
DATABASE_URL=
# Migrations and administrative scripts use a direct/session connection.
DATABASE_DIRECT_URL=

# Server-only Supabase key. Prefer the current sb_secret_ key type. The Phase 6
# owner flow does not need this key at runtime; reserve it for trusted jobs.
SUPABASE_SECRET_KEY=

# Phase 4 uses Dodo Payments behind an adapter. `mock` is deterministic and
# local-only. `test_mode` requires a Dodo test API key and a one-time INR
# product configured with "pay what you want" enabled. Live mode is not
# accepted by this phase's environment schema.
DODO_PAYMENTS_ENVIRONMENT=mock
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_BUSINESS_ID=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
PAYMENTS_ENABLED=false

# Turnstile is mocked locally. Hosted environments must select `cloudflare`.
TURNSTILE_MODE=mock
TURNSTILE_SECRET_KEY=
SUBMISSION_HMAC_SECRET=
# Base64-encoded 32-byte AES key used for private outbox recipient data.
PRIVATE_DATA_ENCRYPTION_KEY=

# Server-only integrations (configured in later phases).
RESEND_API_KEY=
CLICK_HMAC_SECRET_CURRENT=
CLICK_HMAC_SECRET_PREVIOUS=
SENTRY_AUTH_TOKEN=
CRON_SECRET=
